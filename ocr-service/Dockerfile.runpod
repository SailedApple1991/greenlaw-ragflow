# =============================================================================
# RunPod Serverless PaddleOCR GPU Worker
# =============================================================================
# This Dockerfile builds a GPU-enabled PaddleOCR worker for RunPod Serverless.
#
# Build:
#   docker build -f Dockerfile.runpod -t username/paddleocr-runpod:latest .
#
# Push:
#   docker push username/paddleocr-runpod:latest
# =============================================================================

FROM runpod/pytorch:2.1.0-py3.10-cuda11.8.0-devel-ubuntu22.04

LABEL maintainer="RAGFlow Team"
LABEL description="PaddleOCR GPU worker for RunPod Serverless"

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PADDLE_OCR_LANG=en

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt /requirements.txt
RUN pip install --no-cache-dir -r /requirements.txt

# Install PaddlePaddle GPU version
# Note: Use the specific CUDA version matching the base image
RUN pip install --no-cache-dir \
    paddlepaddle-gpu==3.0.0 \
    -i https://www.paddlepaddle.org.cn/packages/stable/cu118/

# Install PaddleOCR
RUN pip install --no-cache-dir paddleocr==2.9.1

# Pre-download OCR models to speed up cold start
RUN python -c "from paddleocr import PaddleOCR; PaddleOCR(lang='en', device='cpu')" || true

# Copy handler code
COPY handler.py /handler.py

# Set working directory
WORKDIR /

# RunPod serverless entry point
CMD ["python", "-u", "/handler.py"]
